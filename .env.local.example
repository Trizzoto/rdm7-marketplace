# Copy this file to .env.local and fill in your Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional. Server-only HMAC secret used to sign Studio "capture tokens"
# (auto-generated preview screenshots). If unset, falls back to
# SUPABASE_SERVICE_ROLE_KEY, so the feature works without extra config.
# CAPTURE_TOKEN_SECRET=some-long-random-string
